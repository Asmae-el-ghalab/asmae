          let cspReportsCount = 0;
          document.addEventListener('securitypolicyviolation', async (event) => {
            if (event.originalPolicy.includes('report-uri') || cspReportsCount >= 500) {
              return;
            }
            cspReportsCount += 1;
            await fetch('/_/_/csp_report/', {
              method: 'POST',
              body: JSON.stringify({
                'csp-report': {
                  'blocked-uri': event.blockedURI,
                  'column-number': event.columnNumber,
                  disposition: event.disposition,
                  'document-uri': event.documentURI,
                  'effective-directive': event.effectiveDirective,
                  'line-number': event.lineNumber,
                  'original-policy': event.originalPolicy,
                  referrer: event.referrer,
                  sample: event.sample,
                  'source-file': event.sourceFile,
                  'status-code': event.statusCode,
                  'violated-directive': event.violatedDirective,
                  'is-metatag': true,
                },
              }),
            });
          });
      </script><link href="./vidoeP_files/12931-8637b22e7d8d1723.css" rel="stylesheet"><link href="./vidoeP_files/AuthDesktopCSSImports-c42a176af79517f2.css" rel="stylesheet"><script crossorigin="anonymous" defer="" fetchpriority="high" nonce="" src="./vidoeP_files/runtime.fr-f4844d37cd9161f6.mjs"></script><script crossorigin="anonymous" defer="" fetchpriority="high" nonce="" src="./vidoeP_files/polyfills-83e5c1c59820ea67.mjs"></script><script crossorigin="anonymous" defer="" fetchpriority="high" nonce="" src="./vidoeP_files/locale-fr-data-js-46597f6f6db1fb74.mjs"></script><script crossorigin="anonymous" defer="" fetchpriority="high" nonce="" src="./vidoeP_files/vendor-react-af50895ae38c2ce2.mjs"></script><script crossorigin="anonymous" defer="" fetchpriority="high" nonce="" src="./vidoeP_files/83119-af89630e877b3efd.mjs"></script><script crossorigin="anonymous" defer="" fetchpriority="high" nonce="" src="./vidoeP_files/57201-3a3fd0256f81db3f.mjs"></script><script crossorigin="anonymous" defer="" fetchpriority="high" nonce="" src="./vidoeP_files/75114-6954abf25a304206.mjs"></script><script crossorigin="anonymous" defer="" fetchpriority="high" nonce="" src="./vidoeP_files/76594-3b60beb4ba5fad68.mjs"></script><script crossorigin="anonymous" defer="" fetchpriority="high" nonce="" src="./vidoeP_files/13474-e6b1cbe89b5e9a54.mjs"></script><script crossorigin="anonymous" defer="" fetchpriority="high" nonce="" src="./vidoeP_files/42298-56da6c0e4e582d00.mjs"></script><script crossorigin="anonymous" defer="" fetchpriority="high" nonce="" src="./vidoeP_files/49838.fr-e2ce0132a4ac87db.mjs"></script><script crossorigin="anonymous" defer="" fetchpriority="high" nonce="" src="./vidoeP_files/5966.fr-6b1803e4d0702d29.mjs"></script><script crossorigin="anonymous" defer="" fetchpriority="high" nonce="" src="./vidoeP_files/62119-6546424fd4a037c4.mjs"></script><script crossorigin="anonymous" defer="" fetchpriority="high" nonce="" src="./vidoeP_files/80347-865b36dcd460b58a.mjs"></script>